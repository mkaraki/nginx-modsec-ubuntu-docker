{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "packageRules": [
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["debian", "ubuntu"],
            "matchUpdateTypes": ["digest"],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "groupName": "GitHub Artifact Actions",
            "matchManagers": [
              "github-actions"
            ],
            "automerge": true,
            "automergeType": "pr"
        },
        {
            "matchFileNames": ["Dockerfile"],
            "matchDatasources": ["deb"],
            "registryUrls": [
                "https://deb.debian.org/debian-security?suite=trixie&components=main,contrib,non-free&binaryArch=amd64",
                "https://deb.debian.org/debian?suite=trixie&components=main,contrib,non-free&binaryArch=amd64"
            ],
            "automerge": true,
            "automergeType": "pr"
        }
    ],
    "assignees": [
        "mkaraki"
    ],
    "pinDigests": true
}
